# DrChrono OAuth Credentials (Required)
# Create an API application at: Account > API in DrChrono
DRCHRONO_CLIENT_ID=your_client_id_here
DRCHRONO_CLIENT_SECRET=your_client_secret_here
DRCHRONO_REDIRECT_URI=http://localhost:8765/callback

# FHIR/ConnectEHR Credentials (Optional)
# Only needed if using FHIR tools
# Set up at: Account > API > ConnectEHR Setup for FHIR
DRCHRONO_FHIR_BASE_URL=
DRCHRONO_FHIR_CLIENT_ID=
DRCHRONO_FHIR_CLIENT_SECRET=

# Token Storage Location (Optional)
# Defaults to ~/.drchrono/tokens.json
DRCHRONO_TOKEN_FILE=

# SimpleMem - Persistent Clinical Memory (Optional)
# Get credentials at: https://simplemem.io
# Enables cross-session memory for patient encounters and clinical alerts
SIMPLEMEM_API_URL=
SIMPLEMEM_ACCESS_TOKEN=
